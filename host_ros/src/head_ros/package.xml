<?xml version="1.0"?>
<package format="3">
  <name>head_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 USB bridge for the Teensy tendon head controller.</description>
  <maintainer email="robotics@example.invalid">Head Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>head_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-qt-binding</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2-storage-mcap</exec_depend>
</package>
